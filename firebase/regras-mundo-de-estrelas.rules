    // ======================= Mundo de Estrelas (início) =======================
    // Cole este bloco DENTRO de "match /databases/{database}/documents { ... }",
    // logo antes da última chave de fechamento. Não apague as regras antigas:
    // elas continuam protegendo o Quadro de Estrelas (app/, meta/, log/, pending/, devo/, advent/).

    function mdeSignedIn() { return request.auth != null; }
    function mdeSuper() {
      return mdeSignedIn() && request.auth.token.email == 'luanasabatovicz@gmail.com' && request.auth.token.email_verified == true;
    }
    function mdeMember(fid) {
      return mdeSignedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
    }

    // Códigos de licença: só a administradora cria e lista; a família usa o código uma vez.
    match /licenses/{code} {
      allow get: if mdeSignedIn();
      allow list, create, delete: if mdeSuper();
      allow update: if mdeSuper() || (
        mdeSignedIn()
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'family', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.family)).data.license == code
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.family)).data.owner == request.auth.uid
      );
    }

    // Posições das peças nas cenas: todos leem, só a administradora grava.
    match /contentOverrides/{seasonId} {
      allow read: if mdeSignedIn();
      allow write: if mdeSuper();
    }

    match /families/{fid} {
      allow read: if mdeSignedIn() && (
        request.auth.uid in resource.data.memberIds
        || (request.auth.token.email_verified == true && request.auth.token.email in resource.data.invites)
        || mdeSuper()
      );
      // Criar família exige um código de licença livre, usado no mesmo envio.
      allow create: if mdeSignedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && get(/databases/$(database)/documents/licenses/$(request.resource.data.license)).data.usedBy == null
        && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.license)).data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.license)).data.family == fid;
      allow update: if mdeSignedIn() && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.license == resource.data.license)
        // aceitar convite: só entra a própria pessoa, e o convite dela sai da lista
        || (request.auth.token.email_verified == true
          && request.auth.token.email in resource.data.invites
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'invites'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
          && !(request.auth.token.email in request.resource.data.invites))
      );
      allow delete: if false;

      // Crianças, rotina, registros, pedidos, progresso, álbum, Advento: só quem é da família.
      match /{sub=**} {
        allow read, write: if mdeMember(fid);
      }
    }
    // ======================= Mundo de Estrelas (fim) =======================
